flowchart TB
  cust["<b>Customer</b>"]:::person
  subgraph BB["BrewBox Platform · AWS"]
    web["<b>Web shop</b><br/>Next.js on Amplify Hosting"]:::internal
    app["<b>Mobile app</b><br/>React Native"]:::internal
    cog["<b>Amazon Cognito</b><br/>Customer sign-in"]:::managed
    gw["<b>Amazon API Gateway</b><br/>REST API"]:::managed
    ord["<b>Order Service</b><br/>Node.js · ECS Fargate"]:::internal
    sub["<b>Subscription Service</b><br/>Node.js · Lambda"]:::internal
    sch["<b>EventBridge Scheduler</b><br/>Daily renewal run"]:::managed
    db[("<b>Orders DB</b><br/>Aurora PostgreSQL")]:::store
    bus[["<b>Event bus</b><br/>Amazon EventBridge"]]:::managed
    q[["<b>Fulfilment queue</b><br/>Amazon SQS"]]:::store
    ful["<b>Fulfilment Worker</b><br/>Node.js · Lambda"]:::internal
    ses["<b>Amazon SES</b><br/>Emails"]:::managed
  end
  stripe["<b>Stripe</b>"]:::external
  wms["<b>3PL Warehouse</b>"]:::external
  cust --> web
  cust --> app
  web -- "Signs in [OIDC]" --> cog
  web -- "HTTPS/JSON + JWT" --> gw
  app -- "HTTPS/JSON + JWT" --> gw
  gw -- "VPC Link" --> ord
  sch -- "Invokes daily" --> sub
  sub -- "Creates renewal<br/>orders [REST]" --> ord
