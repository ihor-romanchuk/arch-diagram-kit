%% notes: Where does each part of BrewBox run in production, and how is it connected?
flowchart TB
  users["<b>Customers</b>"]:::person
  subgraph EDGE["AWS edge (global)"]
    r53["<b>Route 53</b><br/>brewbox.com"]:::managed
    cf["<b>CloudFront + AWS WAF</b>"]:::managed
  end
  subgraph AWS["AWS · eu-central-1 (Frankfurt) · prod account"]
    amp["<b>Amplify Hosting</b><br/>Next.js web shop"]:::managed
    apigw["<b>API Gateway</b><br/>Regional REST API"]:::managed
    subgraph VPC["VPC 10.20.0.0/16 · 3 AZs"]
      subgraph PUB["Public subnets"]
        nat["<b>NAT Gateway</b>"]:::managed
      end
      subgraph PRIV["Private subnets"]
        direction LR
        alb["<b>Internal ALB</b>"]:::managed
        ecs["<b>ECS Fargate</b><br/>Order Service (Node.js)"]:::internal
        lam["<b>Lambda in VPC</b><br/>Subscription, Fulfilment<br/>(Node.js)"]:::internal
      end
      subgraph DATA["Data subnets"]
        rds[("<b>Aurora PostgreSQL</b><br/>Multi-AZ")]:::store
      end
    end
    subgraph REG["Regional managed services"]
      eb[["<b>EventBridge</b>"]]:::managed
      sqs[["<b>SQS</b>"]]:::store
      ses["<b>SES</b>"]:::managed
      cog["<b>Cognito</b>"]:::managed
    end
    tgw["<b>Transit Gateway</b><br/>+ Site-to-Site VPN"]:::managed
  end
  subgraph ONPREM["Customer data centre"]
    sap["<b>SAP ERP</b>"]:::external
  end
  ext["<b>Stripe, 3PL SFTP</b><br/>Internet"]:::external
  users --> r53 --> cf
  cf -- "/*" --> amp
  cf -- "/api/*" --> apigw
  apigw -- "VPC Link" --> alb --> ecs
  ecs -- "SQL" --> rds
  lam -- "SQL" --> rds
  PRIV -- "Events, queues,<br/>email, auth" --> REG
  PRIV -- "Outbound HTTPS/SFTP" --> nat --> ext
  ecs -- "Invoices" --> tgw --> sap
  style EDGE fill:#FBFCFD,stroke:#9AA8B3
  style AWS fill:#FBFCFD,stroke:#7A8A97
